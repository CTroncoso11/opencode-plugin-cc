{
  "description": "Optional stop-time review gate for OpenCode Companion.",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" session-lifecycle-hook.mjs SessionEnd",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" stop-review-gate-hook.mjs",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
